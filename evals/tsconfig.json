{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "typeRoots": ["../packages/catalog/node_modules/@types"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["**/*.ts"],
  "exclude": ["fixtures", "reports"]
}
