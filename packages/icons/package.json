{
  "name": "@fluxnative/icons",
  "version": "0.0.0",
  "description": "FluxNative UI icon table: one closed set of names mapped to SF Symbols, Material Symbols and inline SVG paths, plus an <Icon> that draws the SVG.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inspireui/fluxnative-ui.git",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/inspireui/fluxnative-ui#readme",
  "bugs": "https://github.com/inspireui/fluxnative-ui/issues",
  "type": "module",
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./table": "./src/table.ts"
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fluxnative/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.84",
    "react-native-svg": ">=15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "typescript": "~6.0.3"
  }
}
