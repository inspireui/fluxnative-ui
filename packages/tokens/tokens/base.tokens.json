{
  "$description": "FluxNative UI base tokens. Spacing, radius and type mirror the Tailwind CSS v4 default scale on purpose: models already write `p-4`, `rounded-xl`, `text-lg`, so FluxNative UI keeps those names and values. Do not rename them.",
  "spacing": {
    "$type": "dimension",
    "$description": "Tailwind v4 dynamic spacing: `p-<n>` = n × unit, for any n that is a multiple of 0.25.",
    "unit": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "DEFAULT": {
      "$value": {
        "value": 4,
        "unit": "px"
      },
      "$description": "Bare `rounded`."
    },
    "md": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "2xl": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "3xl": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "4xl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "text": {
    "$description": "Tailwind v4 `text-*` sizes. `line-height` is a unitless ratio, as in Tailwind and DTCG typography.",
    "xs": {
      "size": {
        "$type": "dimension",
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "line-height": {
        "$type": "number",
        "$value": 1.3333
      }
    },
    "sm": {
      "size": {
        "$type": "dimension",
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "line-height": {
        "$type": "number",
        "$value": 1.4286
      }
    },
    "base": {
      "size": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "line-height": {
        "$type": "number",
        "$value": 1.5
      }
    },
    "lg": {
      "size": {
        "$type": "dimension",
        "$value": {
          "value": 18,
          "unit": "px"
        }
      },
      "line-height": {
        "$type": "number",
        "$value": 1.5556
      }
    },
    "xl": {
      "size": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "line-height": {
        "$type": "number",
        "$value": 1.4
      }
    },
    "2xl": {
      "size": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "line-height": {
        "$type": "number",
        "$value": 1.3333
      }
    },
    "3xl": {
      "size": {
        "$type": "dimension",
        "$value": {
          "value": 30,
          "unit": "px"
        }
      },
      "line-height": {
        "$type": "number",
        "$value": 1.2
      }
    },
    "4xl": {
      "size": {
        "$type": "dimension",
        "$value": {
          "value": 36,
          "unit": "px"
        }
      },
      "line-height": {
        "$type": "number",
        "$value": 1.1111
      }
    },
    "5xl": {
      "size": {
        "$type": "dimension",
        "$value": {
          "value": 48,
          "unit": "px"
        }
      },
      "line-height": {
        "$type": "number",
        "$value": 1
      }
    },
    "6xl": {
      "size": {
        "$type": "dimension",
        "$value": {
          "value": 60,
          "unit": "px"
        }
      },
      "line-height": {
        "$type": "number",
        "$value": 1
      }
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "thin": {
      "$value": 100
    },
    "extralight": {
      "$value": 200
    },
    "light": {
      "$value": 300
    },
    "normal": {
      "$value": 400
    },
    "medium": {
      "$value": 500
    },
    "semibold": {
      "$value": 600
    },
    "bold": {
      "$value": 700
    },
    "extrabold": {
      "$value": 800
    },
    "black": {
      "$value": 900
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": {
        "value": 150,
        "unit": "ms"
      }
    },
    "normal": {
      "$value": {
        "value": 250,
        "unit": "ms"
      }
    },
    "slow": {
      "$value": {
        "value": 400,
        "unit": "ms"
      }
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "emphasized": {
      "$value": [
        0.3,
        0,
        0,
        1
      ]
    }
  },
  "glass": {
    "$description": "Parameters for the glass ladder below the native tiers. Native Liquid Glass ignores these.",
    "blur-radius": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "saturate": {
      "$type": "number",
      "$value": 1.8
    }
  },
  "chrome": {
    "$type": "dimension",
    "$description": "Navigation chrome metrics for the custom (non-native) tiers.",
    "app-bar-height": {
      "$value": {
        "value": 44,
        "unit": "px"
      }
    },
    "tab-bar-height": {
      "$value": {
        "value": 56,
        "unit": "px"
      }
    },
    "tab-bar-inset": {
      "$value": {
        "value": 16,
        "unit": "px"
      },
      "$description": "Gap between the floating tab bar and the screen edges."
    }
  },
  "font": {
    "$type": "fontFamily",
    "$description": "Font stack per role, first choice first; the last entry is a generic family. Hosts load no web fonts yet, so v0.1 allows system families only.",
    "display": {
      "$value": [
        "System"
      ],
      "$description": "Display, headline and title roles."
    },
    "text": {
      "$value": [
        "System"
      ],
      "$description": "Body, label and caps roles."
    },
    "numeric": {
      "$value": [
        "System"
      ],
      "$description": "Prices, counters and stats.",
      "$extensions": {
        "dev.fluxnative": {
          "fontVariant": [
            "tabular-nums"
          ]
        }
      }
    }
  },
  "type": {
    "$type": "typography",
    "$description": "Text roles. A template's brand sets its own sizes; these defaults sit on the `text` scale and match the catalog primitives.",
    "display": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{text.3xl.size}",
        "fontWeight": "{font-weight.bold}",
        "lineHeight": "{text.3xl.line-height}",
        "letterSpacing": {
          "value": -0.5,
          "unit": "px"
        }
      },
      "$description": "The largest line on a screen."
    },
    "headline": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{text.2xl.size}",
        "fontWeight": "{font-weight.bold}",
        "lineHeight": "{text.2xl.line-height}",
        "letterSpacing": {
          "value": -0.3,
          "unit": "px"
        }
      },
      "$description": "Screen and hero headings."
    },
    "title": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "{text.xl.size}",
        "fontWeight": "{font-weight.bold}",
        "lineHeight": "{text.xl.line-height}",
        "letterSpacing": {
          "value": -0.2,
          "unit": "px"
        }
      },
      "$description": "Sheet and section titles."
    },
    "body": {
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "{text.base.size}",
        "fontWeight": "{font-weight.normal}",
        "lineHeight": "{text.base.line-height}",
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Running text."
    },
    "body-sm": {
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "{text.sm.size}",
        "fontWeight": "{font-weight.normal}",
        "lineHeight": "{text.sm.line-height}",
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Secondary text, captions, state-view body."
    },
    "label": {
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "{text.sm.size}",
        "fontWeight": "{font-weight.medium}",
        "lineHeight": "{text.sm.line-height}",
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Chips, text actions, tabs."
    },
    "caps": {
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": {
          "value": 11,
          "unit": "px"
        },
        "fontWeight": "{font-weight.semibold}",
        "lineHeight": 1.2727,
        "letterSpacing": {
          "value": 1.2,
          "unit": "px"
        }
      },
      "$description": "Eyebrows; render in upper case."
    },
    "numeric": {
      "$value": {
        "fontFamily": "{font.numeric}",
        "fontSize": "{text.base.size}",
        "fontWeight": "{font-weight.semibold}",
        "lineHeight": "{text.base.line-height}",
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Prices, counters and stats."
    }
  },
  "shape": {
    "$type": "dimension",
    "$description": "Corner radius per surface role. Values alias the `radius` scale only.",
    "control": {
      "$value": "{radius.full}",
      "$description": "Buttons and other pill controls."
    },
    "card": {
      "$value": "{radius.2xl}",
      "$description": "Cards, cells, inline banners."
    },
    "card-inner": {
      "$value": "{radius.xl}",
      "$description": "Media and panels inside a card; never rounder than the card."
    },
    "sheet": {
      "$value": "{radius.3xl}",
      "$description": "Top corners of a bottom sheet."
    },
    "chip": {
      "$value": "{radius.full}"
    },
    "avatar": {
      "$value": "{radius.full}"
    },
    "field": {
      "$value": "{radius.xl}",
      "$description": "Text fields and search pills."
    },
    "well": {
      "$value": "{radius.lg}",
      "$description": "Recessed fills: skeleton blocks, image wells."
    }
  },
  "elevation": {
