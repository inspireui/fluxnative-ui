  "interaction": {
    "$description": "The interaction profile: defaults the catalog primitives read. Enum choices (press haptic, skeleton mode and colours) live in a brand file's `$extensions`.",
    "press": {
      "active-scale": {
        "$type": "number",
        "$value": 0.96,
        "$description": "Scale while pressed; 1 turns it off."
      },
      "hit-slop": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "px"
        },
        "$description": "Extra hit area on every side."
      },
      "spring-speed": {
        "$type": "number",
        "$value": 40
      },
      "spring-bounciness": {
        "$type": "number",
        "$value": 0
      }
    },
    "reveal": {
      "offset": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$description": "Rise distance of an entrance."
      },
      "duration": {
        "$type": "duration",
        "$value": {
          "value": 600,
          "unit": "ms"
        }
      },
      "stagger": {
        "$type": "duration",
        "$value": {
          "value": 55,
          "unit": "ms"
        },
        "$description": "Extra delay per list index."
      }
    },
    "skeleton": {
      "pulse": {
        "$type": "duration",
        "$value": {
          "value": 900,
          "unit": "ms"
        },
        "$description": "One half of a breath: fade out, then back."
      },
      "min-opacity": {
        "$type": "number",
        "$value": 0.5
      },
      "reduced-opacity": {
        "$type": "number",
        "$value": 0.8,
        "$description": "Held still when Reduce Motion is on."
      }
    }
  },
  "layout": {
    "$type": "dimension",
    "$description": "Screen layout metrics.",
    "gutter": {
      "$value": {
        "value": 16,
        "unit": "px"
      },
      "$description": "Side padding of a screen."
    },
    "safe-top": {
      "$value": {
        "value": 8,
        "unit": "px"
      },
      "$description": "Space under the host's safe-area inset before the first row."
    },
    "tab-bar-height": {
      "$value": "{chrome.tab-bar-height}",
      "$description": "The template's tab bar height."
    }
