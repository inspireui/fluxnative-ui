{
  "name": "@fluxnative/tokens",
  "version": "0.0.0",
  "description": "FluxNative UI design tokens: W3C DTCG source compiled to TypeScript constants and a Tailwind v4 / Uniwind theme.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inspireui/fluxnative-ui.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/inspireui/fluxnative-ui#readme",
  "bugs": "https://github.com/inspireui/fluxnative-ui/issues",
  "type": "module",
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "fluxnative-tokens": "src/bin.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/generated/theme.css",
    "./tokens/*": "./tokens/*"
  },
  "files": [
    "src",
    "tokens"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node src/build.ts",
    "check": "node src/build.ts --check",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3"
  }
}
